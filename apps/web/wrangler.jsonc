{
  // Cloudflare Workers config for the OpenNext adapter (@opennextjs/cloudflare).
  // SPIKE: de-risk only. `main`/`assets` point at the `.open-next` build output.
  // nodejs_compat keeps the Node runtime so postgres.js / node:crypto /
  // supabase-js / server actions keep working (the reason we chose OpenNext over
  // the legacy @cloudflare/next-on-pages).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metra-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Runtime Postgres reaches Supabase through Hyperdrive (pooling + edge cache).
  // `id` is the real `metra-db` Hyperdrive config (Supabase session pooler,
  // aws-1-eu-west-1, :5432). `localConnectionString` is ONLY used by `wrangler
  // dev` local emulation and MUST point at a throwaway local Postgres, never the
  // shared Supabase project.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "acc17973ea6847328d6b523bb54953f0",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/metra_cf_spike"
    }
  ],
  // Workers Logs ON, so the reference a user is shown on an unexpected failure
  // ("tell us the code ABC-123") can be found in the dashboard afterwards, not
  // only during a live `wrangler tail`. Only what the app writes with console.*
  // is kept: every such line is redacted (lib/actions/loggable-failure.ts).
  // INVOCATION logs stay OFF: they record each request's URL, and a client link
  // (/d, /p, /c, /v) carries its access token in the path.
  // TRACES stay OFF (Round E S2): a fetch span records the full URL, and a
  // signed Storage URL carries its token in the query.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // Cloudflare Browser Rendering binding used by lib/pdf/render.ts
  // (@cloudflare/puppeteer) to render proposal PDFs.
  "browser": {
    "binding": "BROWSER"
  },
  // Workers Rate Limiting bindings for the Public API (v1) — see
  // lib/api/rate-limit.ts. Off-platform both bindings are absent and the limiters
  // degrade to ALLOW; ON Cloudflare a missing binding THROWS rather than serving
  // the API unlimited, so neither entry may be removed.
  //   API_RATE_LIMITER         100 req / 60s, keyed per resolved API key id.
  //   API_PREAUTH_RATE_LIMITER 300 req / 60s, keyed per caller (cf-connecting-ip),
  //     charged BEFORE key resolution so an unauthenticated flood of garbage
  //     bearer tokens cannot hammer the database for free. Its ceiling is higher
  //     than the per-key one because one caller IP can legitimately carry several
  //     keys.
  // The client portal's per-link brake (Round D), see
  // lib/share/portal-rate-limit.ts. Same rule: ON Cloudflare a missing binding
  // refuses the act or read rather than serving the portal unlimited.
  //   PORTAL_ACT_RATE_LIMITER   30 req / 60s, keyed per share link (a sha256
  //     prefix of the token): every server action under /d/[token].
  //   PORTAL_READ_RATE_LIMITER its "limit" below / 60s (the one line to change),
  //     keyed the same way: the document and logo routes and a document's
  //     comment thread.
  // Every counter here is PER DATA CENTRE, not global: a caller spread across k
  // colos gets k x the limit below. The numbers bound the work one colo can be
  // made to do; they are not a global quota.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "API_PREAUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "PORTAL_ACT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PORTAL_READ_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
