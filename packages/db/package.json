{
  "name": "@merta/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "apply-rls": "tsx src/scripts/apply-rls.ts",
    "seed": "tsx src/seed/seed-two-orgs.ts",
    "test": "vitest run --dir src",
    "test:isolation": "vitest run --config vitest.isolation.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
