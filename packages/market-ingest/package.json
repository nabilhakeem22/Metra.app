{
  "name": "@metra/market-ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The gate for the monthly MHUC building-materials bulletin: check, review, publish, withdraw. No network call other than Postgres.",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "vitest run --dir src",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@metra/db": "*",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
