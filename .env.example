# =========================================================================
# Merta — environment template. Copy to `.env` and fill with real values.
# `.env` is gitignored and MUST NEVER be committed. Never print these values.
# =========================================================================

# --- Supabase project (public keys are safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase service role (server-only, full bypass — NEVER expose) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection strings -----------------------------------------
# Session pooler (:5432) — use for drizzle-kit migrations and the isolation
# test. IPv4-friendly.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Transaction pooler (:6543) — use for the postgres.js runtime client.
# Requires prepare:false (no prepared statements over the transaction pooler).
DATABASE_POOL_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct connection (:5432) — may be IPv6-only. Fallback only.
DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- i18n ----------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE=ar-EG
