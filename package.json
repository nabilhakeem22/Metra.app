{
  "name": "metra",
  "private": true,
  "version": "0.0.0",
  "description": "Metra — project and cost control for fit-out contractors (P0 foundations)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @metra/web",
    "build": "npm run build -w @metra/web",
    "lint": "eslint . --config eslint.config.mjs",
    "test": "npm run test -w @metra/web && npm run test -w @metra/db",
    "test:isolation": "npm run test:isolation -w @metra/db",
    "test:actions": "npm run test:actions -w @metra/web",
    "db:generate": "npm run generate -w @metra/db",
    "db:migrate": "npm run migrate -w @metra/db",
    "db:apply-rls": "npm run apply-rls -w @metra/db",
    "db:seed": "npm run seed -w @metra/db",
    "i18n:translate": "tsx scripts/i18n/translate.ts",
    "i18n:validate": "tsx scripts/i18n/validate.ts",
    "i18n:review": "tsx scripts/i18n/review.ts",
    "i18n:apply": "tsx scripts/i18n/apply.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "prettier": "file:./stubs/prettier"
  },
  "overrides": {
    "prettier": "$prettier"
  }
}
